APP_NAME="OnePay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-onepay-domain.up.railway.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_LIMITER=database
MAIL_MAILER=log
ALLOW_REGISTRATION=false
INSTALLER_ALLOW_REMOTE_DB=true
PROCESS_TYPE=all
RUN_MIGRATIONS=true
# Set a unique node identifier for provider verification when enabling it.
GATEWAY_VERIFICATION_NODE_ID=onepay-railway-1
# Never commit real secrets, credentials, or production .env files.
